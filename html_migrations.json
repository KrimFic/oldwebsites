{
  "elements": {
    "big": {
      "tag": "span",
      "style": { "font-size": "larger" }
    },
    "center": {
      "tag": "div",
      "style": { "text-align": "center" }
    },
    "font": {
      "tag": "span",
      "attributes": {
        "color": { "property": "color" },
        "face": { "property": "font-family" },
        "size": {
          "property": "font-size",
          "values": {
            "1": "xx-small",
            "2": "small",
            "3": "medium",
            "4": "large",
            "5": "x-large",
            "6": "xx-large",
            "7": "xxx-large"
          }
        }
      }
    },
    "strike": { "tag": "s" }
  },
  "attributes": {
    "bgcolor": { "property": "background-color" }
  }
}
